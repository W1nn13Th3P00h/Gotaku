# Copie ce fichier vers .env.local et remplis les valeurs.
# .env.local n'est pas versionné. Ne colle jamais une clé ici.

# Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé exposée au navigateur.
# Projets récents : Project Settings > API Keys > publishable key (sb_publishable_...)
# Projets plus anciens : la clé anon. Renseigner l'une OU l'autre.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service, utilisée uniquement par `npm run seed`. Contourne la RLS.
# Ne jamais l'importer depuis du code client.
# Projets récents : secret key (sb_secret_...). Plus anciens : service_role key.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lot 5 seulement. Générer avec : npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:toi@exemple.fr
